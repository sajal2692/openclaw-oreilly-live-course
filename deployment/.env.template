# Copy to deployment/.env, fill in your values, and chmod 600 .env.
# Compose reads this file for host-side paths and passes credentials to both
# services. docker-compose.yml pins container-side paths separately.
# Recreate containers after env changes; `docker compose restart` keeps old env.

# Local tag built by Dockerfile.course from the pinned official 2026.9.5 image.
OPENCLAW_IMAGE=openclaw:2026.9.5-course

# Generate with: openssl rand -hex 32
OPENCLAW_GATEWAY_TOKEN=

# Use lan inside a bridged container. Compose publishes to host 127.0.0.1 only.
# With Linux host networking for managed Tailscale Serve, use loopback instead.
# Valid bind modes: auto, lan, loopback, tailnet, custom. A custom IP uses config.
OPENCLAW_GATEWAY_BIND=lan
OPENCLAW_GATEWAY_PORT=18789
OPENCLAW_TZ=America/Vancouver

# Host paths. The guide assumes root on a Linux VPS.
OPENCLAW_CONFIG_DIR=/root/.openclaw
OPENCLAW_WORKSPACE_DIR=/root/.openclaw/workspace
OPENCLAW_AUTH_PROFILE_SECRET_DIR=/root/.openclaw-auth-profile-secrets

# Uncomment providers you use, or configure auth through onboarding.
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# OPENROUTER_API_KEY=
# GEMINI_API_KEY=

# Single-agent Telegram channel. Create a bot with @BotFather.
# TELEGRAM_BOT_TOKEN=

# Multi-agent variant (Demo 6). See ../multi-agent/README.md.
# ALFRED_BOT_TOKEN=
# CODER_BOT_TOKEN=

# Optional search provider. Configure a matching provider in OpenClaw.
# BRAVE_API_KEY=
# PERPLEXITY_API_KEY=

# Optional GitHub credential for Coder. Scope to the intended demo repository.
# A shared container environment makes this available to both agents.
# GH_TOKEN=
