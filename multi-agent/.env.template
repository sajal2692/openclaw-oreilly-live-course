# Merge these values into the active deployment/.env; do not replace that file.
# Named Telegram accounts for multi-agent/openclaw.example.json5 (Demo 6).
ALFRED_BOT_TOKEN=
CODER_BOT_TOKEN=

# Alfred uses OpenRouter; Coder uses Anthropic Sonnet 5 with an OpenRouter fallback.
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=

# Optional: repository-scoped GitHub token for create-pr.
# Grant Contents and Pull requests write access to the intended repository.
# Add other permissions only if the task needs them (for example workflow edits).
# Shared container environment variables are available to both agents.
# GH_TOKEN=

# Telegram recipient IDs belong in AGENTS.md Tools and automation delivery.
# A TELEGRAM_CHAT_ID env variable alone does not configure pairing or delivery.
