{
  // OpenClaw 2026.9.5, Demo 6: two independently routed personas.
  // Merge with deployment/openclaw.example.json5 and onboarding config.
  // This fragment does not replace gateway authentication or provider auth.
  agents: {
    ownership: "explicit",
    defaults: {
      userTimezone: "America/Vancouver",
      systemAgent: { agentId: "alfred" },
      heartbeat: { every: "0m", agentId: "alfred" },
      models: {
        "openrouter/auto": { alias: "OpenRouter" },
        "openrouter/anthropic/claude-sonnet-4.6": {},
        "anthropic/claude-sonnet-5": { alias: "sonnet" },
      },
      model: {
        primary: "openrouter/anthropic/claude-sonnet-4.6",
        fallbacks: ["openrouter/auto"],
      },
    },
    // 2026.9.5 uses a map keyed by agent ID, not the retired agents.list array.
    entries: {
      alfred: {
        workspace: "/home/node/.openclaw/workspace-alfred",
      },
      coder: {
        workspace: "/home/node/.openclaw/workspace-coder",
        // 0m disables recurring heartbeat polls; targeted event wakes can still run.
        heartbeat: { every: "0m" },
        model: {
          primary: "anthropic/claude-sonnet-5",
          fallbacks: ["openrouter/auto"],
        },
        // Guarded default. The live instructor demo uses mode: "full" deliberately.
        // Full exec can reach both workspaces, credentials, and shared mounts.
        tools: { exec: { mode: "ask" }, fs: { workspaceOnly: true } },
      },
    },
  },
  tools: {
    exec: { mode: "ask" },
    fs: { workspaceOnly: true },
    sessions: { visibility: "agent" },
    agentToAgent: { enabled: false },
  },
  skills: { workshop: { autonomous: { mode: "off" } } },
  plugins: { entries: { "memory-core": { config: { dreaming: { enabled: false } } } } },

  // These rules have the same specificity and disjoint account IDs.
  // OpenClaw generally chooses the most specific matching binding.
  bindings: [
    { agentId: "alfred", match: { channel: "telegram", accountId: "alfred" } },
    { agentId: "coder", match: { channel: "telegram", accountId: "coder" } },
  ],
  channels: {
    telegram: {
      enabled: true,
      defaultAccount: "alfred",
      accounts: {
        alfred: {
          botToken: "${ALFRED_BOT_TOKEN}",
          dmPolicy: "pairing",
          groupPolicy: "disabled",
        },
        coder: {
          botToken: "${CODER_BOT_TOKEN}",
          dmPolicy: "pairing",
          groupPolicy: "disabled",
        },
      },
    },
  },
}
